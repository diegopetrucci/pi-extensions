  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegopetrucci/pi-extensions.git",
    "directory": "extensions/project-mcp-json"
  },
  "files": [
    "index.ts",
    "config.ts",
    "README.md",
    ".pi-fleet-tested-version"
  ],
