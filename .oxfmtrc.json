{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    "**/*.mdx",
    "docs/**",
    "**/docs/**",
    "assets/**",
    "**/assets/**",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.svg",
    "**/*.ico",
    "**/*.bmp",
    "**/*.pdf",
    "**/*.zip",
    "**/*.gz",
    "**/*.woff",
    "**/*.woff2",
    "**/*.ttf",
    "**/*.otf",
    "**/*.mp3",
    "**/*.mp4",
    "**/*.mov",
    "**/*.webm",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/generated/**",
    "**/generated.*",
    "**/*.generated.*",
    "**/*.gen.*",
    "**/*.map",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.py",
    "**/*.pyi",
    "**/*.sh",
    "**/*.bash",
    "**/*.zsh",
    "**/*.fish",
    "**/*.ps1",
    "**/*.psm1",
    "**/*.bat",
    "**/*.cmd",
    "**/*.jsonl",
    "**/*.yaml",
    "**/*.yml",
    "**/.pi-fleet-tested-version",
    "**/*.npmignore",
    "**/LICENSE",
    "extensions/annotate-git-diff/web/index.html",
    "extensions/annotate-last-message/web/index.html"
  ]
}
